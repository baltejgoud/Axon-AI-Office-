{
  "name": "axon-ai-studio",
  "productName": "Axon",
  "version": "0.2.0",
  "description": "Axon — a multi-provider AI desktop platform: chat, code, workspaces, agents, and knowledge.",
  "main": "out/main/index.js",
  "author": "Axon",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "skills:ingest": "node scripts/skills/ingest.cjs",
    "test:desktop": "electron tests/electron-smoke.cjs",
    "start": "electron-vite preview",
    "format": "prettier --write \"src/renderer/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/renderer/src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.10.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "three": "^0.186.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.47.0",
    "prettier": "^3.9.7",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.axon.studio",
    "productName": "Axon",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Axon-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
